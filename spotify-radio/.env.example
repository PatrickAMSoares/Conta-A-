# Client ID do app criado em https://developer.spotify.com/dashboard (é público, pode ir no frontend)
VITE_SPOTIFY_CLIENT_ID=coloque_o_client_id_do_seu_app_spotify

# Deve ser IDÊNTICO a um dos Redirect URIs cadastrados no app do Spotify
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# URL base das Firebase Functions (emulador local ou produção)
# Local:      http://127.0.0.1:5001/SEU_PROJETO_FIREBASE/us-central1
# Produção:   https://us-central1-SEU_PROJETO_FIREBASE.cloudfunctions.net
VITE_API_BASE_URL=http://127.0.0.1:5001/SEU_PROJETO_FIREBASE/us-central1
